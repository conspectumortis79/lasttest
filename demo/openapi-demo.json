{
  "openapi": "3.0.3",
  "info": {
    "title": "Lasttest Demo API",
    "description": "Demo-Spezifikation zum Testen von GET-, POST-, PUT- und DELETE-Anfragen.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8286/demo-api",
      "description": "Lokale lasttest-Demo (funktioniert sofort)"
    },
    {
      "url": "https://staging.lasttest.example.com/demo-api",
      "description": "Staging-Umgebung"
    },
    {
      "url": "https://integration.lasttest.example.com/demo-api",
      "description": "Integration-Umgebung"
    },
    {
      "url": "https://api.lasttest.example.com/demo-api",
      "description": "Produktion"
    }
  ],
  "paths": {
    "/products": {
      "get": {
        "operationId": "listProducts",
        "summary": "Produkte mit optionalem Filter auflisten",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["books", "hardware", "software"],
              "example": "books"
            }
          },
          {
            "name": "available",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "example": true
            }
          },
          {
            "name": "maxPrice",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "format": "double",
              "minimum": 0.01,
              "example": 50.00
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Produktliste"
          }
        }
      },
      "post": {
        "operationId": "createProduct",
        "summary": "Neues Produkt anlegen",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProduct"
              },
              "example": {
                "name": "Clean Code",
                "category": "books",
                "price": 34.95,
                "available": true
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Produkt angelegt"
          }
        }
      }
    },
    "/products/search": {
      "post": {
        "operationId": "searchProducts",
        "summary": "Produkte per JSON-Body suchen (Bearer-Demo)",
        "description": "Verlangt HTTP Bearer Auth. Das `lasttest`-Demo-Backend akzeptiert\n**nur** den unten genannten Demo-Token und liefert sonst\n`401 Unauthorized`.\n\n**Demo-Token (Testzwecke):** `demo-bearer-token`",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductSearch"
              },
              "example": {
                "category": "hardware",
                "available": true,
                "maxPrice": 100.00
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Gefilterte Produktliste"
          },
          "401": {
            "description": "Bearer-Token fehlt"
          }
        }
      }
    },
    "/products/{id}": {
      "get": {
        "operationId": "getProduct",
        "summary": "Produkt anhand seiner ID abrufen",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProductId"
          }
        ],
        "responses": {
          "200": {
            "description": "Produkt gefunden"
          },
          "404": {
            "description": "Produkt nicht gefunden"
          }
        }
      },
      "put": {
        "operationId": "updateProduct",
        "summary": "Produkt aktualisieren",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProductId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProduct"
              },
              "example": {
                "name": "Clean Code, zweite Auflage",
                "category": "books",
                "price": 39.95,
                "available": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Produkt aktualisiert"
          }
        }
      },
      "delete": {
        "operationId": "deleteProduct",
        "summary": "Produkt löschen",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProductId"
          }
        ],
        "responses": {
          "204": {
            "description": "Produkt gelöscht"
          }
        }
      }
    },
    "/products/admin/stats": {
      "get": {
        "operationId": "getAdminStats",
        "summary": "Admin-Statistiken (Basic-Auth-Demo)",
        "description": "Verlangt HTTP Basic Auth (RFC 7617). Das `lasttest`-Demo-Backend\nakzeptiert **nur** das unten genannte Demo-Credentials-Paar\n(case-sensitive) und liefert sonst `401 Unauthorized`.\n\n**Demo-Credentials (Testzwecke):**\n- Username: `alice`\n- Password: `s3cret`",
        "security": [
          {
            "basicAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Statistik als JSON"
          },
          "401": {
            "description": "Basic-Auth fehlt oder ist ungültig"
          }
        }
      }
    },
    "/products/lookup-by-id": {
      "get": {
        "operationId": "lookupProduct",
        "summary": "Produkt per ID nachschlagen (API-Key-Demo)",
        "description": "Verlangt einen API Key im `X-API-Key`-Header. Das\n`lasttest`-Demo-Backend akzeptiert **nur** den unten genannten\nDemo-Key (case-sensitive) und liefert sonst `401 Unauthorized`.\n\n**Demo-API-Key (Testzwecke):** `demo-api-key-12345`",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Produkt als JSON"
          },
          "401": {
            "description": "API-Key fehlt oder ist ungültig"
          },
          "404": {
            "description": "Produkt mit der angegebenen ID existiert nicht"
          }
        }
      }
    },
    "/products/me": {
      "get": {
        "operationId": "getMe",
        "summary": "Aktuellen Benutzer abrufen (OAuth-2.0-Demo)",
        "description": "Verlangt einen OAuth 2.0 Access Token im\n`Authorization: Bearer <token>`-Header (RFC 6750). Das\n`lasttest`-Demo-Backend akzeptiert **nur** den unten genannten\nDemo-Token (case-sensitive) und liefert sonst\n`401 Unauthorized`.\n\n**Demo-Access-Token (Testzwecke):** `demo-oauth2-token-12345`",
        "security": [
          {
            "oauth2": []
          }
        ],
        "responses": {
          "200": {
            "description": "Benutzerinformationen als JSON (mit den dem Token zugewiesenen Scopes)"
          },
          "401": {
            "description": "OAuth-2.0-Token fehlt oder ist ungültig"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "HTTP Basic Authentication (Username + Passwort)"
      },
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "API Key Authentication via X-API-Key-Header (Stripe-/GitHub-Stil)"
      },
      "oauth2": {
        "type": "oauth2",
        "description": "OAuth 2.0 (RFC 6749) — Access Token als Bearer (RFC 6750)",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "http://localhost:8286/demo-api/oauth/token",
            "scopes": {
              "read:products": "Produkte lesen",
              "write:products": "Produkte schreiben"
            }
          },
          "authorizationCode": {
            "authorizationUrl": "http://localhost:8286/demo-api/oauth/authorize",
            "tokenUrl": "http://localhost:8286/demo-api/oauth/token",
            "scopes": {
              "read:products": "Produkte lesen",
              "write:products": "Produkte schreiben"
            }
          }
        }
      }
    },
    "parameters": {
      "ProductId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "format": "int64",
          "example": 1
        }
      }
    },
    "schemas": {
      "CreateProduct": {
        "type": "object",
        "required": ["name", "category", "price"],
        "properties": {
          "name": {
            "type": "string",
            "example": "Clean Code"
          },
          "category": {
            "type": "string",
            "enum": ["books", "hardware", "software"]
          },
          "price": {
            "type": "number",
            "format": "double",
            "minimum": 0.01,
            "example": 34.95
          },
          "available": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "ProductSearch": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": ["books", "hardware", "software"],
            "example": "hardware"
          },
          "available": {
            "type": "boolean",
            "example": true
          },
          "maxPrice": {
            "type": "number",
            "format": "double",
            "minimum": 0.01,
            "example": 100.00
          }
        }
      }
    }
  }
}
